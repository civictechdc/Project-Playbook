---
import sharp from 'sharp';
import { join } from 'node:path';
interface Props { src: string; alt: string; compact?: boolean; caption?: string; }
const { src, alt, caption } = Astro.props;
let width: number | undefined;
let height: number | undefined;
try {
  const metadata = await sharp(join(process.cwd(), 'public', src.replace(/^\//, ''))).metadata();
  width = metadata.width;
  height = metadata.height;
} catch {
  // Keep references to images that are available only in a local checkout usable.
}
const ratio = width && height ? width / height : 1.5;
const imageWidth = ratio < .85 ? '36%, 24rem' : ratio > 1.6 ? '48%, 32rem' : '42%, 28rem';
const imageStyle = `--image-width: min(${imageWidth}${width ? `, ${width}px` : ''}); --image-natural-width: ${width ? `${width}px` : '100%'}`;
---
<div class="image-text" style={imageStyle}>
  <div class="image-text-layout">
    <figure>
      <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
    <div class="image-text-copy"><slot /></div>
  </div>
</div>

<style>
  .image-text { container-type: inline-size; margin-block: 1.5rem; }
  .image-text-layout { display: flow-root; }
  .image-text-copy { min-width: 0; }
  .image-text-copy :global(> :first-child) { margin-top: 0; }
  .image-text-copy :global(> :last-child) { margin-bottom: 0; }
  img { display: block; width: 100%; height: auto; margin: 0; }
  .image-text-layout > figure { width: min(100%, 32rem, var(--image-natural-width)); margin: 0 0 1.25rem; }
  figcaption { margin-top: .5rem; font-size: .95rem; line-height: 1.5; }
  @container (min-width: 38rem) {
    .image-text-layout > figure { float: right; width: var(--image-width); margin: 0 0 1rem 2rem; }
  }
</style>
