<span class="firework" aria-hidden="true">
  {Array.from({ length: 8 }, (_, index) => <span style={`--ray: ${index * 45}deg`} />)}
</span>

<style>
  .firework { position: relative; display: inline-block; width: 0; height: 1em; vertical-align: baseline; pointer-events: none; }
  .firework span { position: absolute; left: 0; top: .4em; width: 3px; height: 3px; border-radius: 50%; background: #deaf4a; opacity: 0; animation: burst 3s ease-out infinite; }
  .firework span:nth-child(even) { background: #104378; }
  @keyframes burst {
    0% { opacity: 0; transform: rotate(var(--ray)) translateX(0) scale(.5); }
    5% { opacity: 1; }
    22% { opacity: .8; }
    30%, 100% { opacity: 0; transform: rotate(var(--ray)) translateX(1.35em) scale(.4); }
  }
  @media (prefers-reduced-motion: reduce) { .firework { display: none; } }
</style>
